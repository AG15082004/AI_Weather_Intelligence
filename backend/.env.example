# Application Environment
APP_ENV=development

# Microsoft Fabric SQL Connection
# Lakehouse: lh_tn_weather_intelligence
FABRIC_SERVER=your-fabric-sql-endpoint.datawarehouse.fabric.microsoft.com
FABRIC_DATABASE=lh_tn_weather_intelligence
# Authentication mode: azure_cli (local dev recommended), interactive, service_principal
FABRIC_AUTH_MODE=azure_cli
FABRIC_TENANT_ID=your-azure-entra-tenant-id-here
FABRIC_ODBC_DRIVER=ODBC Driver 18 for SQL Server
FABRIC_ENCRYPT=yes
FABRIC_TRUST_SERVER_CERTIFICATE=no
FABRIC_CONNECTION_TIMEOUT=30

# Future Production Authentication (Service Principal)
# FABRIC_CLIENT_ID=your-service-principal-client-id
# FABRIC_CLIENT_SECRET=your-service-principal-client-secret

# AI Provider Configuration (OpenAI GPT-6 Luna, Ollama, or Deterministic)
# AI_PROVIDER: 'openai' (production primary: OpenAI GPT-6 Luna Responses API)
#              'ollama' (local development with Qwen3:4b)
#              'deterministic' (strictly verified rule-based engine, zero LLM dependency)
#              'auto' (uses OpenAI when key is set, else Ollama in dev, deterministic fallback)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=1024

# Ollama Configuration (Local Development)
AI_REQUEST_TIMEOUT=30
OLLAMA_CONNECT_TIMEOUT=2.5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Production Security & Monitoring
# Optional administrator key for sensitive operations (cache purge, schema discovery)
# ADMIN_API_KEY=your-secure-random-admin-api-key
AI_RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_BODY_BYTES=1048576
ENABLE_SECURITY_HEADERS=true

# Application Settings
CORS_ORIGINS=https://ai-weather-intelligence-1.onrender.com,https://ai-weather-intelligence.onrender.com,http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=^https://ai-weather-intelligence(-\w+)?\.onrender\.com$
LOG_LEVEL=INFO
CACHE_TTL_SECONDS=300

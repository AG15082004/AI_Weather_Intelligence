# Application Environment
APP_ENV=development

# Microsoft Fabric SQL Connection
# Lakehouse: lh_tn_weather_intelligence
FABRIC_SERVER=your-fabric-sql-endpoint.datawarehouse.fabric.microsoft.com
FABRIC_DATABASE=lh_tn_weather_intelligence
# Authentication mode: azure_cli (local dev recommended), interactive, service_principal
FABRIC_AUTH_MODE=azure_cli
FABRIC_TENANT_ID=your-azure-entra-tenant-id-here
FABRIC_ODBC_DRIVER=ODBC Driver 18 for SQL Server
FABRIC_ENCRYPT=yes
FABRIC_TRUST_SERVER_CERTIFICATE=no
FABRIC_CONNECTION_TIMEOUT=30

# Future Production Authentication (Service Principal)
# FABRIC_CLIENT_ID=your-service-principal-client-id
# FABRIC_CLIENT_SECRET=your-service-principal-client-secret

# Ollama AI Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Application Settings
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://ai-weather-intelligence.onrender.com
CORS_ORIGIN_REGEX=https://.*\.onrender\.com
LOG_LEVEL=INFO
CACHE_TTL_SECONDS=300
